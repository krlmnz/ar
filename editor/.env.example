# Copy to `.env.local` for local development. Never commit real secrets.

# Password gate. Leave blank if you only use GitHub OAuth.
EDITOR_PASSWORD=

# Signs the session cookie. Required in production if EDITOR_PASSWORD is unset.
AUTH_SECRET=

# GitHub OAuth app. Callback: https://editor.andean-road.com/api/auth/callback
# Only these logins may enter (comma-separated). Defaults to krlmnz.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EDITOR_GITHUB_LOGIN=krlmnz
CONTENT_OWNER=krlmnz

# Server-side token with contents:write on krlmnz/ar. Never expose this to the browser.
GITHUB_TOKEN=
GITHUB_REPO=krlmnz/ar
GITHUB_BRANCH=main

# github (default in production when GITHUB_TOKEN is set) or local (writes the files on disk).
CONTENT_SOURCE=
# Repo root when CONTENT_SOURCE=local. Defaults to the parent of editor/.
CONTENT_ROOT=

# Public site and this studio.
PUBLIC_SITE_URL=https://andean-road.com
EDITOR_URL=https://editor.andean-road.com
