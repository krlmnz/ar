# Dependencies
node_modules/

# Build output
_site/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Credentials — see _data/mapbox.js
_data/mapbox.local.json

# Map Atelier hardcodes its own Mapbox token rather than reading the
# build's. Same rule as above: copy config.example.js to config.js and
# fill in the token locally. Netlify needs the real file, so either
# commit it deliberately once the token is URL-restricted, or generate
# it at build time from MAPBOX_TOKEN.
tools-apps/map-atelier/js/config.js

# Local Netlify folder
.netlify

# Claude session-local settings
.claude/settings.local.json

# Staging area for files to delete manually (VM cannot rm)
_to_delete/
