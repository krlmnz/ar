{
  "name": "andean-road",
  "version": "1.0.0",
  "description": "A personal travel guide to Chile — by your bilingual best friend",
  "scripts": {
    "start": "node scripts/build-app-config.js && npx @11ty/eleventy --serve",
    "build": "node scripts/build-app-config.js && npx @11ty/eleventy",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "new": "node scripts/new.js",
    "tokens": "node scripts/build-tokens.js",
    "tokens:check": "node scripts/build-tokens.js --check",
    "app:config": "node scripts/build-app-config.js"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7"
  }
}
