---
layout: base.njk
---

{% set crumbs = [
  {label: "Practical", url: "/practical/" },
  {label: title}
] %}
{% include "partials/breadcrumbs.njk" %}

<article>
  <header class="place-header">
    <div class="place-header__type">Practical</div>
    <h1 class="place-header__title">{{ title }}</h1>
  </header>

  <div class="prose content-column">
    {{ content | safe }}
  </div>

  <div style="margin-top:var(--space-7);max-width:var(--content-width)">
    <hr class="rule">
    <h3 style="font-family:var(--font-display);font-size:var(--text-h3);font-weight:600;margin-bottom:var(--space-2)">More practical info</h3>
    <div class="practical-list">
      {% for p in collections.practical %}
        {% if p.data.slug != slug %}
        <a href="/practical/{{ p.data.slug }}/" class="practical-link">{{ p.data.title }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</article>
