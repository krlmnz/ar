<header class="site-header">
  <div class="wrap site-header__row">
    <a href="/" class="site-title">Andean Road</a>
    <div class="site-header__end">
      <nav class="site-nav" aria-label="Primary">
        <a href="/atelier/">Create</a>
        <a href="/learn/">Learn</a>
        <a href="/tools/">Tools</a>
        <a href="/places/">Places</a>
      </nav>
      {# The one primary CTA. Sits outside .site-nav so it survives the
         nav collapse on phones — the editor is the product. #}
      <a href="/atelier/editor/" class="nav-cta" target="_blank" rel="noopener">Open the editor&nbsp;→</a>
      {# Borrows .theme-toggle so both header buttons share one style;
         search.js opens the dialog via the data attribute — inert without JS. #}
      <button type="button" class="theme-toggle" data-search-open title="Search" aria-label="Search (press /)">
        {% icon "magnifying-glass", size=20 %}
      </button>
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle dark mode">
        {% icon "moon", weight="fill", size=20, class="icon--moon" %}
        {% icon "sun", weight="fill", size=20, class="icon--sun" %}
      </button>
    </div>
  </div>
</header>
