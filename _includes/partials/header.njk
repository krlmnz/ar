<header class="site-header" id="top">
  <div class="site-header__inner">
    <a class="brand-logo" href="/" aria-label="Andean Road home">
      <svg width="41" height="40" viewBox="0 0 41 40" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Andean mountain mark">
        <mask id="andeanLogoMask" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="41" height="40">
          <path d="M20.1702 0H20.0001C8.95435 0 0 8.95433 0 20C0 31.0458 8.95435 40.0001 20.0001 40.0001H20.1702C31.2159 40.0001 40.1703 31.0458 40.1703 20C40.1703 8.95433 31.2159 0 20.1702 0Z" fill="white"/>
        </mask>
        <g mask="url(#andeanLogoMask)">
          <path d="M40.1697 0H0V40H40.1697V0Z" fill="black" fill-opacity="0.86"/>
          <path d="M40 0H0V40H40V0Z" fill="#FCFCFC" fill-opacity="0.32"/>
          <path d="M20.2268 11.6548C18.2097 11.6548 3.9043 28.7411 3.9043 28.7411H20.2268H36.5493C36.5493 28.7411 22.2439 11.6548 20.2268 11.6548Z" fill="white"/>
          <path d="M40.1697 28.7412H0V40H40.1697V28.7412Z" fill="#7C7C7C"/>
          <path d="M40.1697 28.7412H0V40H40.1697V28.7412Z" fill="black" fill-opacity="0.58"/>
          <path d="M0.0283203 33.2109V40.0002H16.4711H29.633L40 40.0001L36.3279 38.5009L0.0283203 33.2109Z" fill="#595959" fill-opacity="0.58"/>
          <path d="M26.3193 35.2299L11.0176 39.9871H40.1586V39.9999H40.1703V39.5673V30.3252L26.3193 35.2299Z" fill="black" fill-opacity="0.58"/>
        </g>
      </svg>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/templates/" {% if page.url.indexOf("/templates/") == 0 or page.url.indexOf("/demo/") == 0 %}aria-current="page"{% endif %}>Templates</a>
      <a href="/places/" {% if page.url.indexOf("/places/") == 0 %}aria-current="page"{% endif %}>Places</a>
      <a href="/regions/" {% if page.url.indexOf("/regions/") == 0 %}aria-current="page"{% endif %}>Regions</a>
    </nav>

    <details class="view-menu" id="viewMenu">
      <summary aria-label="Customize reading view">
        <svg class="view-trigger__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M8 14v6"/>
        </svg>
        <span class="view-trigger__label">Customize view</span>
        <span class="view-trigger__theme" id="currentThemeLabel">Light / Minimal</span>
        <svg class="view-trigger__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg>
      </summary>

      <div class="view-panel" role="group" aria-label="Customize view settings">
        <div class="view-panel__header">
          <span class="view-panel__eyebrow">Reading preferences</span>
          <strong class="view-panel__title">Customize view</strong>
        </div>

        <div class="view-setting">
          <svg class="setting-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
          <div class="view-setting__copy">
            <label class="view-setting__label" for="theme">Theme</label>
            <span class="view-setting__hint">Change contrast and atmosphere.</span>
          </div>
          <div class="select-wrap">
            <select id="theme" class="theme-select" aria-label="Choose a visual theme">
              <option value="light">Light / Minimal</option>
              <option value="night">Night Sky</option>
              <option value="note">Warm Note</option>
              <option value="signal">Signal Hacker</option>
              <option value="news">Grey Newspaper</option>
              <option value="draft">Drafting Grid</option>
            </select>
            <svg class="view-trigger__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg>
          </div>
          {% if theme %}
          <button type="button" class="reset-theme" id="resetPageTheme">Reset to page theme</button>
          {% endif %}
        </div>

        <div class="view-setting">
          <svg class="setting-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 5h16M4 12h11M4 19h8"/>
          </svg>
          <div class="view-setting__copy">
            <span class="view-setting__label">Plain language</span>
            <span class="view-setting__hint">Show short explanations beside technical ideas.</span>
          </div>
          <button class="setting-toggle" id="plainToggle" type="button" aria-pressed="true"><span id="plainState">On</span></button>
        </div>

        <div class="view-setting">
          <svg class="setting-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 19 10 5h2l5 14M7 14h8M18 8h3M19.5 6.5v3"/>
          </svg>
          <div class="view-setting__copy">
            <span class="view-setting__label">Text size</span>
            <span class="view-setting__hint">Adjust the main reading size.</span>
          </div>
          <div class="font-stepper" aria-label="Text size controls">
            <button id="fontDown" type="button" aria-label="Decrease text size">A−</button>
            <output id="fontSizeValue" aria-live="polite">17px</output>
            <button id="fontUp" type="button" aria-label="Increase text size">A+</button>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>
