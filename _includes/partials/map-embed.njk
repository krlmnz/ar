{# Shared map plumbing. A layout sets `mapConfig` (a dict) then includes this.
   Everything the engine needs — sprites, live region, config, script.

   mapbox-gl itself is NOT loaded here: the engine injects it only when the
   map container nears the viewport, so a reader who never scrolls to the map
   never pays for the ~230 KB library. #}

<div data-map-sprites hidden aria-hidden="true">
  {%- for type, iconName in placeIcons %}
  <span data-sprite="{{ type }}">{% icon iconName, weight="fill", size=16 %}</span>
  {%- endfor %}
</div>

<p id="map-status" class="sr-only" role="status" aria-live="polite"></p>

<script type="application/json" id="map-config"
        data-gl="{{ mapbox.version }}"
        {%- if mapbox.styleDark %} data-style-dark="{{ mapbox.styleDark }}"{% endif %}>{{ mapConfig | dump | safe }}</script>
<script src="/assets/js/andean-map.js" defer></script>
