{# REGION MAP — the area explorer.
   Two panels over one map, borrowed in structure from the Atelier's published
   guest view and rebuilt on the site's tokens (sharp corners, semantic colours).

   Left: the region — what it is, and every place in it as a row.
   Right: one place — the full write-up, opened by clicking a row or a pin,
          closed to get back to the whole region.

   Requires `here` (the region's collection items) and `region` in scope.
   The map itself is configured by the caller and rendered by map-shell. #}

<div class="regionmap" data-regionmap>
  <div class="regionmap__stage">
    {% set mapLabel = region.label %}
    {% include "partials/map-shell.njk" %}

    {# ── Overview ─────────────────────────────────────────────────────── #}
    <div class="regionpanel regionpanel--overview" data-region-overview>
      <div class="regionpanel__inner">
        <div class="regionpanel__eyebrow">{{ region.description }}</div>
        <h2 class="regionpanel__title">{{ region.label }}</h2>
        <p class="regionpanel__meta">
          {{ here | length }} {{ "place" if here.length == 1 else "places" }}
        </p>

        <button type="button" class="btn regionpanel__toggle" data-region-toggle
                aria-expanded="true" aria-controls="region-list">Hide the places</button>

        <div class="regionpanel__list" id="region-list">
          {% for item in here %}
          {# data-goto is the engine's contract: clicking this flies the map and
             fires andean:select, which is what opens the detail panel. #}
          <button type="button" class="placerow" data-goto="{{ item.data.slug }}"
                  data-feature="{{ item.data.slug }}" aria-pressed="false"
                  aria-label="Show {{ item.data.title }} on the map">
            <span class="placerow__icon" data-cat="{{ item.data.type }}">
              {% set iconName = placeIcons[item.data.type] or placeIcons._default %}
              {% icon iconName, size=15 %}
            </span>
            <span class="placerow__info">
              <span class="placerow__name">{{ item.data.title }}</span>
              <span class="placerow__note">{{ item.data.subtitle }}</span>
            </span>
          </button>
          {% endfor %}
        </div>
      </div>
    </div>

    {# ── Detail ───────────────────────────────────────────────────────────
       One section per place, all rendered at build time and hidden until
       asked for. Fetching them would be a network round trip and a parser for
       content this site already has — there are at most eight per region. #}
    <div class="regionpanel regionpanel--detail" data-region-detail hidden>
      <button type="button" class="regionpanel__close" data-region-close
              aria-label="Close and show the whole region">
        {% icon "x", size=16 %}
      </button>

      {% for item in here %}
      <article class="placedetail" data-detail="{{ item.data.slug }}" hidden>
        <div class="regionpanel__inner">
          <div class="regionpanel__eyebrow">{{ item.data.type | replace("-", " ") }}</div>
          <h2 class="regionpanel__title">{{ item.data.title }}</h2>
          {% if item.data.subtitle %}
          <p class="placedetail__standfirst">{{ item.data.subtitle }}</p>
          {% endif %}

          {% set facts = [] %}
          {% if item.data.cost_level %}{% set facts = (facts.push(item.data.cost_level), facts) %}{% endif %}
          {% if item.data.duration %}{% set facts = (facts.push(item.data.duration | replace("-", " ")), facts) %}{% endif %}
          {% if item.data.reservations and item.data.reservations != "none" %}
            {% set facts = (facts.push("reservations " + item.data.reservations), facts) %}
          {% endif %}
          {% if facts.length %}
          <p class="regionpanel__meta">{{ facts | join(" · ") }}</p>
          {% endif %}

          {% if item.data.best_for %}
          <p class="placedetail__bestfor"><strong>Best for</strong> {{ item.data.best_for }}</p>
          {% endif %}

          <div class="placedetail__body prose">
            {{ item.templateContent | safe }}
          </div>

          {% if item.data.tip %}
          <div class="tip"><p><strong>Pro tip —</strong> {{ item.data.tip }}</p></div>
          {% endif %}

          <div class="btn-row placedetail__actions">
            <a href="/places/{{ item.data.slug }}/" class="btn btn--filled">Open the full page</a>
            {% if item.data.google_maps %}
            <a href="{{ item.data.google_maps }}" target="_blank" rel="noopener" class="btn">Directions</a>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>

  <p class="regionmap__note">
    <a href="/map/">See every region on the full Andean Road map →</a>
  </p>
</div>
