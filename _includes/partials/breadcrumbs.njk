<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {% for crumb in crumbs %}
    <span class="separator" aria-hidden="true">/</span>
    {% if crumb.url and not loop.last %}
      <a href="{{ crumb.url }}">{{ crumb.label }}</a>
    {% else %}
      <span aria-current="page">{{ crumb.label }}</span>
    {% endif %}
  {% endfor %}
</nav>
