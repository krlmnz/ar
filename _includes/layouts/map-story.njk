---
layout: layouts/base.njk
fullBleed: true
---
{# MAP-STORY — scrollytelling. Text scrolls past a map that stays put and
   moves to each section as it is read. For narrative: a journey, a history,
   a craft tradition traced across a landscape.
   Front matter: title, overline, subtitle, standfirst,
                 steps[]: {id, title, body, lng, lat, zoom, pitch, bearing, place} #}

{% set feats = [] %}
{% for s in steps %}
  {% set p = collections.places | findBySlug(s.place) if s.place %}
  {% set feats = (feats.push({
      id: s.id or ("step-" + loop.index),
      title: s.title,
      type: p.data.type if p else (s.type or ""),
      subtitle: s.subtitle or "",
      url: ("/places/" + p.data.slug + "/") if p else "",
      lng: s.lng or (p.data.coordinates.lng if p),
      lat: s.lat or (p.data.coordinates.lat if p),
      zoom: s.zoom or 12, pitch: s.pitch or 0, bearing: s.bearing or 0
    }), feats) %}
{% endfor %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "story", features: feats } %}

<article class="story">
  <header class="story__opener wrap">
    {% if overline %}<div class="hero-overline">{{ overline }}</div>{% endif %}
    <h1 class="story__title">{{ title }}</h1>
    {% if subtitle %}<p class="story__standfirst">{{ subtitle }}</p>{% endif %}
    <p class="story__cue" aria-hidden="true">Scroll {% icon "arrow-down", size=14 %}</p>
  </header>

  <div class="story__stage">
    <div class="story__map">
      {% set mapLabel = title %}
      {% include "partials/map-shell.njk" %}
    </div>

    <div class="story__steps">
      {% for s in steps %}
      <section class="storystep" data-story-step="{{ s.id or ('step-' + loop.index) }}">
        <div class="storystep__card">
          <div class="storystep__num">{{ "%02d" | format(loop.index) if false else loop.index }}</div>
          <h2 class="storystep__title">{{ s.title }}</h2>
          <p class="storystep__body">{{ s.body }}</p>
          {% if s.place %}
            {% set p = collections.places | findBySlug(s.place) %}
            {% if p %}<a class="storystep__link" href="/places/{{ p.data.slug }}/">{{ p.data.title }} →</a>{% endif %}
          {% endif %}
        </div>
      </section>
      {% endfor %}
    </div>
  </div>

  {% if content %}<div class="wrap prose content-column story__outro">{{ content | safe }}</div>{% endif %}
</article>

{% include "partials/map-embed.njk" %}
