---
layout: layouts/base.njk
fullBleed: true
needsMap: true
---
{# ROUTE — a map and ordered stops. Markdown under the map is the intro.
   stops: a place slug, or title + lng/lat when there is no place page yet.
   distance and days render as badges. #}

{% set feats = [] %}
{% for s in stops %}
  {% set p = collections.places | findBySlug(s.place) if s.place %}
  {% set lng = s.lng if s.lng is not none else (p.data.coordinates.lng if p and p.data.coordinates) %}
  {% set lat = s.lat if s.lat is not none else (p.data.coordinates.lat if p and p.data.coordinates) %}
  {% if lng is not none and lat is not none and not (lng == 0 and lat == 0) %}
    {% set feats = (feats.push({
        id: s.place or ("stop-" + loop.index),
        title: (p.data.title if p else s.title),
        type: (p.data.type if p else (s.type or "")),
        subtitle: s.note or (p.data.subtitle if p else ""),
        url: p.url if p else "",
        lng: lng,
        lat: lat,
        day: s.day or ""
      }), feats) %}
  {% endif %}
{% endfor %}
{% set mapConfig = {
  token: mapbox.token,
  style: mapbox.style,
  mapId: "map",
  mode: "route",
  fit: 80,
  features: feats
} %}

<section class="route">
  <div class="route__map">
    {% set mapLabel = title %}
    {% include "partials/map-shell.njk" %}
    <div class="route__badge">
      <span class="route__badge-title">{{ title }}</span>
      <span class="route__badge-meta">
        {% if distance %}<span>{{ distance }}</span>{% endif %}
        {% if days %}<span>{{ days }}</span>{% endif %}
        <span>{{ feats | length }} stops</span>
      </span>
    </div>
  </div>

  <div class="wrap">
    <header class="route__head">
      {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
      <h1 class="mapstack__title">{{ title }}</h1>
      {% if subtitle %}<p class="mapstack__sub">{{ subtitle }}</p>{% endif %}
    </header>

    {% if content %}<div class="prose content-column">{{ content | safe }}</div>{% endif %}

    <ol class="route__list" role="list">
      {% for f in feats %}
      <li class="routestop" data-feature="{{ f.id }}">
        <button type="button" class="routestop__hit" data-goto="{{ f.id }}" aria-pressed="false"
                aria-label="Show {{ f.title }} on the map">
          <span class="routestop__num">{{ loop.index }}</span>
          <span class="routestop__body">
            {% if f.day %}<span class="routestop__day">{{ f.day }}</span>{% endif %}
            <span class="routestop__title">{{ f.title }}</span>
            {% if f.subtitle %}<span class="routestop__note">{{ f.subtitle }}</span>{% endif %}
          </span>
        </button>
        {% if f.url %}<a class="mapcard__link" href="{{ f.url }}">Read more <span aria-hidden="true">→</span></a>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% include "partials/map-embed.njk" %}
