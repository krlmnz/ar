---
layout: layouts/base.njk
---
{# ARTICLE — long-form editorial. Everything after the front matter is markdown.
   Front matter: title, overline, subtitle, byline, updated, crumbs, further_reading #}

{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

<article class="tpl tpl--article">
  {% include "partials/page-header.njk" %}

  <div class="prose content-column">
    {{ content | safe }}
  </div>

  {% if further_reading and further_reading.length %}
  <div class="section-block">
    <hr class="rule">
    <h2 class="subhead">Further reading</h2>
    <div class="practical-list">
      {% for item in further_reading %}
      <a href="{{ item.url }}" class="practical-link">{{ item.label }}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>
