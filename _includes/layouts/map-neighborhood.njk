---
layout: layouts/base.njk
fullBleed: true
mapPage: true
---
{# MAP-NEIGHBORHOOD — one walkable area at close zoom. Pins are coloured by
   category and a legend decodes them; the list is grouped the same way.
   Front matter: title, overline, subtitle, categories[]: {key, label},
                 places[] (slugs), zoom #}

{% set items = collections.places | bySlugs(places) if places else collections.places %}
{% set feats = items | toFeatures('type', zoom or 15) %}
{% set legend = [] %}
{% for c in categories %}{% set legend = (legend.push({label: c.label, cat: c.key}), legend) %}{% endfor %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "pins", fit: 90, features: feats } %}

<section class="hood">
  <div class="hood__map">
    {% set mapLabel = title %}
    {% set legendTitle = "What's here" %}
    {% include "partials/map-shell.njk" %}
  </div>

  <aside class="hood__panel">
    <header class="mappanel__head">
      {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
      <h1 class="mappanel__title">{{ title }}</h1>
      {% if subtitle %}<p class="mappanel__sub">{{ subtitle }}</p>{% endif %}
    </header>

    {% for c in categories %}
      {% set group = [] %}
      {% for f in feats %}{% if f.category == c.key %}{% set group = (group.push(f), group) %}{% endif %}{% endfor %}
      {% if group | length %}
      <div class="hood__group">
        <h2 class="hood__grouphead">
          <span class="maplegend__swatch" data-cat="{{ c.key }}"></span>{{ c.label }}
          <span class="hood__count">{{ group | length }}</span>
        </h2>
        <ul class="hood__list">
          {% for f in group %}
          <li data-feature="{{ f.id }}" data-cat="{{ f.category }}" class="hoodrow">
            <button type="button" class="hoodrow__hit" data-goto="{{ f.id }}" aria-pressed="false"
                    aria-label="Show {{ f.title }} on the map">
              <span class="hoodrow__title">{{ f.title }}</span>
              <span class="hoodrow__sub">{{ f.subtitle }}</span>
            </button>
            <a class="hoodrow__link" href="{{ f.url }}" aria-label="Read about {{ f.title }}">{% icon "arrow-right", size=14 %}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    {% endfor %}
    {% if content %}<div class="prose hood__intro">{{ content | safe }}</div>{% endif %}
  </aside>
</section>

{% include "partials/map-embed.njk" %}
