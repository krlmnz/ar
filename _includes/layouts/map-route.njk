---
layout: layouts/base.njk
fullBleed: true
mapPage: true
---
{# MAP-ROUTE — a planned road trip. Draws a line through the stops in order,
   with a day-by-day itinerary beneath and trip totals up top.
   Front matter: title, overline, subtitle, standfirst, distance, days,
                 stops[]: {place | title/lng/lat, day, note}

   The opener sits ABOVE the map: a route map is an argument about a sequence,
   and the reader needs to know which trip they are looking at before the line
   means anything. `standfirst` carries the longer description; `subtitle` is
   the one-liner that doubles as the SEO description, so it is the fallback
   rather than the primary. #}

{% set feats = stops | stepFeatures(collections.places, 'route') %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "route", fit: 80, features: feats } %}

<section class="route">
  <header class="route__opener wrap">
    {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
    <h1 class="mapstack__title">{{ title }}</h1>
    {% if standfirst %}<p class="mapstack__sub">{{ standfirst }}</p>
    {% elif subtitle %}<p class="mapstack__sub">{{ subtitle }}</p>{% endif %}
    <div class="route__facts">
      {% if distance %}<span>{{ distance }}</span>{% endif %}
      {% if days %}<span>{{ days }}</span>{% endif %}
      <span>{{ feats | length }} stops</span>
    </div>
  </header>

  <div class="route__map">
    {% set mapLabel = title %}
    {% include "partials/map-shell.njk" %}
    {# The badge overlay is gone. It carried the title and trip totals back when
       the headline sat below the map; with the opener above, it repeated both
       within one screen and covered the first stop doing it. #}
  </div>

  <div class="wrap">
    {% if content %}<div class="prose content-column">{{ content | safe }}</div>{% endif %}

    <ol class="route__list" role="list">
      {% for f in feats %}
      <li class="routestop" data-feature="{{ f.id }}">
        <button type="button" class="routestop__hit" data-goto="{{ f.id }}" aria-pressed="false"
                aria-label="Show {{ f.title }} on the map">
          <span class="routestop__num">{{ loop.index }}</span>
          <span class="routestop__body">
            {% if f.day %}<span class="routestop__day">{{ f.day }}</span>{% endif %}
            <span class="routestop__title">{{ f.title }}</span>
            {% if f.subtitle %}<span class="routestop__note">{{ f.subtitle }}</span>{% endif %}
          </span>
        </button>
        {% if f.url %}<a class="mapcard__link" href="{{ f.url }}">Read more <span aria-hidden="true">→</span></a>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% include "partials/map-embed.njk" %}
