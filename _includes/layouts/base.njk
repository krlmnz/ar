<!DOCTYPE html>
<html lang="en"{% if theme %} data-page-theme="{{ theme | escape }}"{% endif %}{% if not mapbox.token %} class="no-map"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light dark">
  <title>{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if published == false or gate %}<meta name="robots" content="noindex">{% endif %}

  <meta property="og:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta property="og:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">{% endif %}

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  {% include "partials/analytics.njk" %}

  {# Theme, plain-language, and type size — before first paint. #}
  <script>
    (function () {
      var root = document.documentElement;
      var themes = ['light', 'night', 'note', 'signal', 'news', 'draft'];
      var theme = localStorage.getItem('roadtrip-theme');
      if (!theme) {
        var legacy = localStorage.getItem('theme');
        if (legacy === 'dark') theme = 'night';
      }
      // A page `theme` is the default only when the visitor has not saved one.
      if (!theme) theme = root.getAttribute('data-page-theme');
      root.dataset.theme = themes.indexOf(theme) === -1 ? 'light' : theme;
      root.dataset.plain = localStorage.getItem('roadtrip-plain') === 'off' ? 'off' : 'on';
      var size = Number(localStorage.getItem('roadtrip-size')) || 17;
      size = Math.min(22, Math.max(15, size));
      root.style.setProperty('--base', size + 'px');
    })();
  </script>

  {% if needsMap %}
  <link rel="preconnect" href="https://api.mapbox.com">
  <link rel="preconnect" href="https://events.mapbox.com">
  {% endif %}

  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a class="skip" href="#main-content">Skip to content</a>

  {% include "partials/header.njk" %}

  {% if fieldGuide %}
  <div class="shell field-guide">
    {% include "partials/demo-note.njk" %}
    {{ content | safe }}
  </div>
  {% elif fullBleed %}
  <main id="main-content" class="bleed">
    {% include "partials/demo-note.njk" %}
    {{ content | safe }}
  </main>
  {% else %}
  <div class="shell">
    <main id="main-content" class="reading{{ ' reading--wide' if wide }}">
      {% include "partials/demo-note.njk" %}
      {{ content | safe }}
    </main>
  </div>
  {% endif %}

  {% include "partials/footer.njk" %}

  {% if gate %}
  <script src="/assets/js/editor-gate.js" defer></script>
  {% endif %}
  <script src="/assets/js/view.js" defer></script>
</body>
</html>
