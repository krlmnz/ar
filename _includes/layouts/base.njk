<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {%- set metaDescription = seo.description if seo and seo.description else (description or subtitle or site.description) %}
  <meta name="description" content="{{ metaDescription }}">

  {# Canonical URL #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if published == false or noindex %}<meta name="robots" content="noindex">{% endif %}

  {# Open Graph. `resolveCover` only returns a URL when the image file actually
     exists on disk — a dead og:image is worse than none. #}
  {%- set coverUrl = cover | resolveCover(page) if cover else '' %}
  <meta property="og:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{{ 'article' if updated else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  {% if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}
  {% if coverUrl %}<meta property="og:image" content="{{ site.url }}{{ coverUrl }}">
  {% if cover_alt %}<meta property="og:image:alt" content="{{ cover_alt }}">{% endif %}{% endif %}

  {# Twitter Card #}
  <meta name="twitter:card" content="{{ 'summary_large_image' if coverUrl else 'summary' }}">
  <meta name="twitter:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {% if coverUrl %}<meta name="twitter:image" content="{{ site.url }}{{ coverUrl }}">{% endif %}

  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">

  {% include "partials/analytics.njk" %}

  {# Theme — must run before first paint to avoid a flash of light theme #}
  <script>
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.dataset.theme = t;
  </script>

  {# Map layouts talk to Mapbox — start the handshake during HTML parse.
     Every map layout sets mapPage: true in its front matter. #}
  {% if mapPage %}
  <link rel="preconnect" href="https://api.mapbox.com">
  <link rel="preconnect" href="https://events.mapbox.com">
  {% endif %}

  {# Fonts — Rethink Sans + Source Serif 4, self-hosted #}
  <link rel="preload" href="/assets/fonts/rethink-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin>

  {# Styles #}
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/search.css">
</head>
<body{% if searchContext %} data-search-context="{{ searchContext }}"{% endif %}>
  <a href="#main-content" class="skip-link">Skip to content</a>

  {% include "partials/header.njk" %}

  {# Map layouts set fullBleed so the canvas can run edge to edge; they wrap
     their own text sections in .wrap themselves. #}
  <main id="main-content" class="{{ 'bleed' if fullBleed else 'wrap' }}">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/search.njk" %}

  <script>
    const root = document.documentElement;
    function toggleTheme() {
      const isDark = root.dataset.theme === 'dark';
      root.dataset.theme = isDark ? '' : 'dark';
      localStorage.setItem('theme', isDark ? '' : 'dark');
      // The map engine re-styles its basemap on this — see andean-map.js.
      window.dispatchEvent(new CustomEvent('themechange'));
    }
  </script>
  <script src="/assets/js/search.js" defer></script>
</body>
</html>
