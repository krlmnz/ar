<!DOCTYPE html>
<html lang="en" data-theme="andean">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  {# Canonical URL #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Open Graph #}
  <meta property="og:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta property="og:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">{% endif %}

  {# Twitter Card #}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  {% include "partials/analytics.njk" %}

  {# Color scheme — must run before first paint to avoid a flash of light theme.
     The Andean theme lives on data-theme; light/dark is data-colorscheme. #}
  <script>
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.dataset.colorscheme = t;
  </script>

  {# Map pages talk to Mapbox — start the handshake during HTML parse #}
  {% if page.url == "/map/" %}
  <link rel="preconnect" href="https://api.mapbox.com">
  <link rel="preconnect" href="https://events.mapbox.com">
  {% endif %}

  {# Fonts — Rethink Sans, self-hosted #}
  <link rel="preload" href="/assets/fonts/rethink-sans-latin.woff2" as="font" type="font/woff2" crossorigin>

  {# Styles #}
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  {% include "partials/header.njk" %}

  {# Map layouts set fullBleed so the canvas can run edge to edge; they wrap
     their own text sections in .wrap themselves. #}
  <main id="main-content" class="{{ 'bleed' if fullBleed else 'wrap' }}">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script>
    const root = document.documentElement;
    function toggleTheme() {
      const isDark = root.dataset.colorscheme === 'dark';
      root.dataset.colorscheme = isDark ? '' : 'dark';
      localStorage.setItem('theme', isDark ? '' : 'dark');
    }
  </script>
</body>
</html>
