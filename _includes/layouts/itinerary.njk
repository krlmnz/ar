---
layout: layouts/base.njk
---
{# ITINERARY — each h2 is a day. "Day 1 — Title" splits into the overline and title.
   A line that is only `place: slug` links that day to a published place. #}

{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

{% set trip = content | days %}
{% set overline = overline or "Itinerary" %}

<article class="tpl tpl--itinerary">
  {% include "partials/page-header.njk" %}

  {% if trip.intro %}
  <div class="prose content-column">{{ trip.intro | safe }}</div>
  {% endif %}

  {% if trip.days.length %}
  {% set linkedCount = trip.days | countPlaces(collections.places) %}
  <div class="itin-summary">
    <span>{{ trip.days | length }} {{ "day" if trip.days | length == 1 else "days" }}</span>
    {% if linkedCount %}<span>{{ linkedCount }} linked {{ "place" if linkedCount == 1 else "places" }}</span>{% endif %}
  </div>

  <ol class="steps steps--timeline" role="list">
    {% for day in trip.days %}
    <li class="step" id="{{ day.id }}">
      <div>
        {% if day.overline %}<div class="step__overline">{{ day.overline }}</div>{% endif %}
        <h2 class="step__title">{{ day.title }}</h2>
        {% if day.html %}<div class="step__body prose">{{ day.html | safe }}</div>{% endif %}
        {% if day.place %}
          {% set linked = collections.places | findBySlug(day.place) %}
          {% if linked %}
          <p class="step__body"><a href="{{ linked.url }}">{{ linked.data.title }} →</a></p>
          {% endif %}
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</article>
