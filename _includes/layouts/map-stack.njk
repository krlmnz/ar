---
layout: layouts/base.njk
fullBleed: true
---
{# MAP-STACK — full-width map under the header, cards UNDERNEATH in a grid.
   Use when the places are the content and the map is the orientation device.
   Front matter: title, overline, subtitle, places[] (slugs), height #}

{% set items = collections.places | bySlugs(places) if places else collections.places %}
{# No legend on this layout, so pins stay one neutral hue rather than
   colour-coding a variable the reader has no key for. #}
{% set feats = items | toFeatures %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "pins", fit: 64, features: feats } %}

<section class="mapstack">
  <div class="mapstack__map mapstack__map--{{ height or 'tall' }}">
    {% set mapLabel = title %}
    {% include "partials/map-shell.njk" %}
  </div>

  <div class="wrap">
    <header class="mapstack__head">
      {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
      <h1 class="mapstack__title">{{ title }}</h1>
      {% if subtitle %}<p class="mapstack__sub">{{ subtitle }}</p>{% endif %}
    </header>

    {% if content %}<div class="prose content-column">{{ content | safe }}</div>{% endif %}

    <ul class="mapcards mapcards--grid">
      {% for f in feats %}
      <li>
        <article class="mapcard" data-feature="{{ f.id }}" >
          <button type="button" class="mapcard__hit" data-goto="{{ f.id }}" aria-pressed="false"
                  aria-label="Show {{ f.title }} on the map">
            <span class="mapcard__icon">
              {% set iconName = placeIcons[f.type] or placeIcons._default %}
              {% icon iconName, weight="fill", size=18 %}
            </span>
            <span class="mapcard__body">
              <span class="mapcard__overline">{{ f.type | replace("-", " ") }}</span>
              <span class="mapcard__title">{{ f.title }}</span>
              <span class="mapcard__sub">{{ f.subtitle }}</span>
            </span>
          </button>
          <a class="mapcard__link" href="{{ f.url }}">Read more <span aria-hidden="true">→</span></a>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% include "partials/map-embed.njk" %}
