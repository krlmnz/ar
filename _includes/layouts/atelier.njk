<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.css">
  <link rel="stylesheet" href="/assets/atelier/atelier.css">
</head>
<body class="atelier{% if guest %} atelier--guest{% endif %}">
  <noscript><p class="noscript">Map atelier needs JavaScript to draw the map.</p></noscript>
  {{ content | safe }}
  <script src="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.js"></script>
  <script type="module" src="{{ script }}"></script>
</body>
</html>
