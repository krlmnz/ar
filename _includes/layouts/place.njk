---
layout: layouts/base.njk
---

{% set regionData = regions[region] if regions and region %}
{% set crumbs = [
  {label: "Regions", url: "/regions/" },
  {label: regionData.label if regionData else region, url: "/regions/" + region + "/" if region},
  {label: title}
] %}
{% include "partials/breadcrumbs.njk" %}

{% set m = [] %}
{% if regionData %}{% set m = (m.push(regionData.label), m) %}{% endif %}
{% if cost_level %}{% set m = (m.push(cost_level), m) %}{% endif %}
{% if duration %}{% set m = (m.push(duration | replace("-", " ")), m) %}{% endif %}
{% if time_from and time_from.santiago %}{% set m = (m.push(time_from.santiago + " from Santiago"), m) %}{% endif %}
{% if reservations and reservations != "none" %}{% set m = (m.push("Reservations " + reservations), m) %}{% endif %}
{% set overline = type | replace("-", " ") %}
{% set meta = m %}

<article>
  {% include "partials/page-header.njk" %}

  <div class="prose content-column">
    {{ content | safe }}
  </div>

  {% if tip %}
  <div class="tip content-column">
    <p><strong>Pro tip —</strong> {{ tip }}</p>
  </div>
  {% endif %}

  {% if spanish and spanish.useful_phrases %}
  <div class="content-column section-block">
    <h2 class="subhead">Phrases you'll need</h2>
    <div class="phrase-list">
      {% for p in spanish.useful_phrases %}
      <div class="phrase-item">
        <span class="phrase-item__text">"{{ p.phrase }}"</span>
        <span class="phrase-item__meaning">{{ p.meaning }}</span>
      </div>
      {% endfor %}
    </div>
    {% if spanish.pronunciation %}
    <p class="note-line">{{ spanish.pronunciation }}</p>
    {% endif %}
  </div>
  {% endif %}

  {% if bring %}
  <div class="content-column section-block">
    <h2 class="subhead">What to bring</h2>
    <div class="tag-row">
      {% for item in bring %}
      <span class="tag">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if tags and tags.length %}
  <div class="content-column section-block">
    <h2 class="subhead">More like this</h2>
    <div class="tag-row">
      {% for t in tags %}
      <a href="/tags/{{ t }}/" class="tag">{{ tagInfo[t].label if tagInfo[t] else t | replace("-", " ") }}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if google_maps %}
  <div class="content-column section-block btn-row">
    <a href="{{ google_maps }}" target="_blank" rel="noopener" class="btn btn--filled">View on Google Maps</a>
    {% if website %}
    <a href="{{ website }}" target="_blank" rel="noopener" class="btn">Visit website</a>
    {% endif %}
  </div>
  {% endif %}

  {% if related and related.length %}
  <div class="section-block">
    <hr class="rule">
    <h2 class="subhead">You might also like</h2>
    <div class="place-grid">
      {% for relSlug in related %}
        {% set place = collections.places | findBySlug(relSlug) %}
        {% if place %}
          {% include "partials/place-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>

{# JSON-LD #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": {{ title | dump | replace("</", "<\\/") | safe }},
  "description": {{ (subtitle or description or "") | dump | replace("</", "<\\/") | safe }},
  {% if coordinates %}"geo": {"@type": "GeoCoordinates", "latitude": {{ coordinates.lat }}, "longitude": {{ coordinates.lng }}},{% endif %}
  "address": {"@type": "PostalAddress", "addressCountry": "CL"},
  "url": "{{ site.url }}/places/{{ slug }}/"
}
</script>
