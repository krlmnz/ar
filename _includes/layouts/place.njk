---
layout: layouts/base.njk
needsMap: true
---
{# PLACE — a destination.
   Required once you publish: title, slug, type, subtitle, region, coordinates.
   published: false keeps the page previewable and off listings, maps, and the sitemap.
   Map pin is omitted when coordinates are missing or still 0,0. #}

{% set regionData = regions[region] if regions and region %}
{% if page.url and "/places/" in page.url %}
  {% set crumbs = [
    {label: "Places", url: "/places/" },
    {label: regionData.label if regionData else region, url: "/regions/" + region + "/" if region},
    {label: title}
  ] %}
{% endif %}
{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

{% set m = [] %}
{% if regionData %}{% set m = (m.push(regionData.label), m) %}{% endif %}
{% if cost_level %}{% set m = (m.push(cost_level), m) %}{% endif %}
{% if duration %}{% set m = (m.push(duration | replace("-", " ")), m) %}{% endif %}
{% if time_from and time_from.santiago %}{% set m = (m.push(time_from.santiago + " from Santiago"), m) %}{% endif %}
{% if reservations and reservations != "none" %}{% set m = (m.push("Reservations " + reservations), m) %}{% endif %}
{% set overline = type | replace("-", " ") %}
{% set meta = m %}
{% set hasPin = coordinates and (coordinates.lat != 0 or coordinates.lng != 0) %}

<article class="tpl tpl--place">
  {% if sample %}
  <p class="sample-flag">Sample place — delete it when you add your own. New places start as <code>published: false</code>.</p>
  {% endif %}

  {% include "partials/page-header.njk" %}

  {% if hasPin %}
  <div class="place-map">
    {% set mapLabel = title %}
    {% include "partials/map-shell.njk" %}
  </div>
  {% set mapConfig = {
    token: mapbox.token,
    style: mapbox.style,
    mapId: "map",
    mode: "pins",
    fit: 72,
    features: [{
      id: slug or title,
      title: title,
      type: type or "",
      subtitle: subtitle or "",
      url: page.url,
      lng: coordinates.lng,
      lat: coordinates.lat
    }]
  } %}
  {% include "partials/map-embed.njk" %}
  {% endif %}

  <div class="prose content-column">
    {{ content | safe }}
  </div>

  {% if tip %}
  <div class="tip content-column">
    <p><strong>Tip —</strong> {{ tip }}</p>
  </div>
  {% endif %}

  {% if spanish and spanish.useful_phrases %}
  <div class="content-column section-block">
    <h2 class="subhead">Phrases you'll need</h2>
    <div class="phrase-list">
      {% for p in spanish.useful_phrases %}
      {% if p.phrase %}
      <div class="phrase-item">
        <span class="phrase-item__text">"{{ p.phrase }}"</span>
        <span class="phrase-item__meaning">{{ p.meaning }}</span>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% if spanish.pronunciation %}
    <p class="note-line">{{ spanish.pronunciation }}</p>
    {% endif %}
  </div>
  {% endif %}

  {% if bring %}
  <div class="content-column section-block">
    <h2 class="subhead">What to bring</h2>
    <div class="tag-row">
      {% for item in bring %}
      <span class="tag">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if audience and audience.length %}
  <div class="content-column section-block">
    <h2 class="subhead">Good for</h2>
    <div class="tag-row">
      {% for key in audience %}
      <span class="tag">{{ audiences[key].label if audiences[key] else key }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if tags and tags.length %}
  <div class="content-column section-block">
    <h2 class="subhead">More like this</h2>
    <div class="tag-row">
      {% for t in tags %}
        {% if collections.byTag[t] %}
        <a href="/tags/{{ t }}/" class="tag">{{ tagInfo[t].label if tagInfo[t] else t | replace("-", " ") }}</a>
        {% else %}
        <span class="tag">{{ tagInfo[t].label if tagInfo[t] else t | replace("-", " ") }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if google_maps or website %}
  <div class="content-column section-block btn-row">
    {% if google_maps %}
    <a href="{{ google_maps }}" target="_blank" rel="noopener" class="btn btn--filled">View on Google Maps</a>
    {% endif %}
    {% if website %}
    <a href="{{ website }}" target="_blank" rel="noopener" class="btn">Visit website</a>
    {% endif %}
  </div>
  {% endif %}

  {% if related and related.length %}
  <div class="section-block">
    <hr class="rule">
    <h2 class="subhead">You might also like</h2>
    <div class="place-grid">
      {% for relSlug in related %}
        {% set place = collections.places | findBySlug(relSlug) %}
        {% if place %}
          {% include "partials/place-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": {{ title | dump | replace("</", "<\\/") | safe }},
  "description": {{ (subtitle or description or "") | dump | replace("</", "<\\/") | safe }},
  {% if hasPin %}"geo": {"@type": "GeoCoordinates", "latitude": {{ coordinates.lat }}, "longitude": {{ coordinates.lng }}},{% endif %}
  "address": {"@type": "PostalAddress", "addressCountry": "CL"},
  "url": "{{ site.url }}{{ page.url }}"
}
</script>
