---
layout: layouts/base.njk
fullBleed: true
---
{# MAP-AREA — an area guide covering several sub-regions. The map orients;
   each area gets a band of its own with its places. Zooming to an area is a
   single click, so the reader can compare parts of a large territory.
   Front matter: title, overline, subtitle, areas[]: {key, label, blurb, places[]} #}

{% set feats = [] %}
{% for a in areas %}
  {% for i in collections.places | bySlugs(a.places) %}
    {% if i.data.coordinates %}
    {% set feats = (feats.push({
        id: i.data.slug, title: i.data.title, type: i.data.type or "",
        category: a.key, subtitle: i.data.subtitle or "",
        url: "/places/" + i.data.slug + "/",
        lng: i.data.coordinates.lng, lat: i.data.coordinates.lat
      }), feats) %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% set legend = [] %}
{% for a in areas %}{% set legend = (legend.push({label: a.label, cat: a.key}), legend) %}{% endfor %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "pins", fit: 70, features: feats } %}

<section class="area">
  <div class="area__map">
    {% set mapLabel = title %}
    {% set legendTitle = "Areas" %}
    {% include "partials/map-shell.njk" %}
  </div>

  <div class="wrap">
    <header class="area__head">
      {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
      <h1 class="mapstack__title">{{ title }}</h1>
      {% if subtitle %}<p class="mapstack__sub">{{ subtitle }}</p>{% endif %}
    </header>

    {% if content %}<div class="prose content-column">{{ content | safe }}</div>{% endif %}

    {% for a in areas %}
    <section class="areaband">
      <div class="areaband__head">
        <span class="maplegend__swatch" data-cat="{{ a.key }}"></span>
        <h2 class="areaband__title">{{ a.label }}</h2>
        {% if a.blurb %}<p class="areaband__blurb">{{ a.blurb }}</p>{% endif %}
      </div>
      <ul class="mapcards mapcards--grid">
        {% for i in collections.places | bySlugs(a.places) %}
        <li>
          <article class="mapcard" data-feature="{{ i.data.slug }}" data-cat="{{ a.key }}">
            <button type="button" class="mapcard__hit" data-goto="{{ i.data.slug }}" aria-pressed="false"
                    aria-label="Show {{ i.data.title }} on the map">
              <span class="mapcard__icon">
                {% set iconName = placeIcons[i.data.type] or placeIcons._default %}
                {% icon iconName, weight="fill", size=18 %}
              </span>
              <span class="mapcard__body">
                <span class="mapcard__overline">{{ i.data.type | replace("-", " ") }}</span>
                <span class="mapcard__title">{{ i.data.title }}</span>
                <span class="mapcard__sub">{{ i.data.subtitle }}</span>
              </span>
            </button>
            <a class="mapcard__link" href="/places/{{ i.data.slug }}/">Read more <span aria-hidden="true">→</span></a>
          </article>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>
</section>

{% include "partials/map-embed.njk" %}
