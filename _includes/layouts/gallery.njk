---
layout: layouts/base.njk
---
{# GALLERY — an image on its own line, then an italic caption.
   Anything before the first image is the intro. Anything after is a close. #}

{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

{% set gallery = content | gallery %}
{% set overline = overline or "Gallery" %}

<article class="tpl tpl--gallery">
  {% include "partials/page-header.njk" %}

  {% if gallery.intro %}
  <div class="prose content-column">{{ gallery.intro | safe }}</div>
  {% endif %}

  {% if gallery.figures.length %}
  <div class="figure-grid figure-grid--feature">
    {% for fig in gallery.figures %}
    <figure class="figure{{ ' figure--feature' if loop.first }}">
      {% if fig.src %}
        <img src="{{ fig.src }}" alt="{{ fig.alt }}" loading="lazy" decoding="async">
      {% else %}
        <div class="placeholder-img" role="img" aria-label="{{ fig.alt or fig.caption }}">
          {% icon "image", size=24 %}
        </div>
      {% endif %}
      {% if fig.caption %}<figcaption>{{ fig.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  {% if gallery.tail %}
  <div class="prose content-column">{{ gallery.tail | safe }}</div>
  {% endif %}
</article>
