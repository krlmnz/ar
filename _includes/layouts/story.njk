---
layout: layouts/base.njk
fullBleed: true
needsMap: true
---
{# STORY — scrolly map. Advanced.
   steps: title, body, and a camera (lng, lat, zoom, pitch, bearing).
   Optional place slug. Markdown after the front matter is the closing note. #}

{% set feats = [] %}
{% for s in steps %}
  {% set p = collections.places | findBySlug(s.place) if s.place %}
  {% set lng = s.lng if s.lng is not none else (p.data.coordinates.lng if p and p.data.coordinates) %}
  {% set lat = s.lat if s.lat is not none else (p.data.coordinates.lat if p and p.data.coordinates) %}
  {% if lng is not none and lat is not none %}
    {% set feats = (feats.push({
        id: s.id or ("step-" + loop.index),
        title: s.title,
        type: p.data.type if p else (s.type or ""),
        subtitle: s.subtitle or "",
        url: p.url if p else "",
        lng: lng,
        lat: lat,
        zoom: s.zoom or 12,
        pitch: s.pitch or 0,
        bearing: s.bearing or 0
      }), feats) %}
  {% endif %}
{% endfor %}
{% set mapConfig = {
  token: mapbox.token,
  style: mapbox.style,
  mapId: "map",
  mode: "story",
  features: feats
} %}

<article class="story">
  <header class="story__opener wrap">
    {% if overline %}<div class="hero-overline">{{ overline }}</div>{% endif %}
    <h1 class="story__title">{{ title }}</h1>
    {% if subtitle %}<p class="story__standfirst">{{ subtitle }}</p>{% endif %}
    <p class="story__cue" aria-hidden="true">Scroll {% icon "arrow-down", size=14 %}</p>
  </header>

  <div class="story__stage">
    <div class="story__map">
      {% set mapLabel = title %}
      {% include "partials/map-shell.njk" %}
    </div>

    <div class="story__steps">
      {% for s in steps %}
      <section class="storystep" data-story-step="{{ s.id or ('step-' + loop.index) }}">
        <div class="storystep__card">
          <div class="storystep__num">{{ loop.index | pad2 }}</div>
          <h2 class="storystep__title">{{ s.title }}</h2>
          {% if s.body %}<p class="storystep__body">{{ s.body }}</p>{% endif %}
          {% if s.place %}
            {% set p = collections.places | findBySlug(s.place) %}
            {% if p %}<a class="storystep__link" href="{{ p.url }}">{{ p.data.title }} →</a>{% endif %}
          {% endif %}
        </div>
      </section>
      {% endfor %}
    </div>
  </div>

  {% if content %}<div class="wrap prose content-column story__outro">{{ content | safe }}</div>{% endif %}
</article>

{% include "partials/map-embed.njk" %}
