---
layout: layouts/base.njk
fullBleed: true
mapPage: true
---
{# MAP-SPLIT — full-width map starting under the header, cards to the LEFT.
   The map is the page. Use for browsing a set of places in one region.
   Front matter: title, overline, subtitle, places[] (slugs) or all: true #}

{% set items = collections.places | bySlugs(places) if places else collections.places %}
{# No legend on this layout, so pins stay one neutral hue rather than
   colour-coding a variable the reader has no key for. #}
{% set feats = items | toFeatures %}
{% set mapConfig = { token: mapbox.token, style: mapbox.style, mapId: "map",
                     mode: "pins", fit: 72, features: feats } %}

<section class="mapsplit">
  <div class="mapsplit__panel">
    <header class="mappanel__head">
      {% if overline %}<div class="mappanel__overline">{{ overline }}</div>{% endif %}
      <h1 class="mappanel__title">{{ title }}</h1>
      {% if subtitle %}<p class="mappanel__sub">{{ subtitle }}</p>{% endif %}
      <div class="mappanel__meta">
        <span id="map-count">{{ feats | length }} places</span>
        <button type="button" class="linkbtn" data-map-reset>Reset map</button>
      </div>

      {# Region filter. Opt-in via `filters: true`, so the template pages that
         demo this layout stay a plain map. Built from the regions actually
         present in the feature set, never from the full regions table — a chip
         that filters to nothing is worse than no chip. #}
      {% if filters %}
      {% set seen = [] %}
      {% for f in feats %}
        {% if f.region and f.region not in seen %}{% set seen = (seen.push(f.region), seen) %}{% endif %}
      {% endfor %}
      {% if seen.length > 1 %}
      <div class="mapfilter" role="group" aria-label="Filter places by region">
        <button type="button" class="chip" data-map-filter="region" data-filter-value="" aria-pressed="true">All</button>
        {% for r in seen %}
        <button type="button" class="chip" data-map-filter="region" data-filter-value="{{ r }}" aria-pressed="false">
          {{ regions[r].label if regions[r] else r | replace("-", " ") }}
        </button>
        {% endfor %}
      </div>
      {% endif %}
      {% endif %}
    </header>

    <ul class="mapcards mapcards--stack">
      {% for f in feats %}
      {% include "partials/mapcard.njk" %}
      {% endfor %}
    </ul>
  </div>

  <div class="mapsplit__map">
    {% set mapLabel = title %}
    {% include "partials/map-shell.njk" %}
  </div>
</section>

{% if content %}<div class="wrap prose content-column mapafter">{{ content | safe }}</div>{% endif %}
{% include "partials/map-embed.njk" %}
