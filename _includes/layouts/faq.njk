---
layout: layouts/base.njk
---
{# FAQ — each h2 is a question; the paragraphs under it are the answer.
   They render as details/summary. A page with no h2s is left as prose
   (so a hand-written details block still works). #}

{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

{% set faq = content | faq %}
{% set overline = overline or "FAQ" %}

<article class="tpl tpl--faq">
  {% include "partials/page-header.njk" %}

  {% if faq.sections.length %}
    {% if faq.intro %}
    <div class="prose content-column">{{ faq.intro | safe }}</div>
    {% endif %}

    <div class="faq-list">
      {% for item in faq.sections %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary class="faq-item__q" id="{{ item.id }}">{{ item.title }}</summary>
        <div class="faq-item__a prose">{{ item.html | safe }}</div>
      </details>
      {% endfor %}
    </div>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq.sections %}
        {
          "@type": "Question",
          "name": {{ item.title | dump | replace("</", "<\\/") | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.html | striptags | dump | replace("</", "<\\/") | safe }} }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    </script>
  {% elif content %}
    <div class="prose content-column">{{ content | safe }}</div>
  {% endif %}
</article>
