---
layout: layouts/base.njk
---
{# PRACTICAL — do this.
   Write a "You'll need" heading and a list, then a numbered list for the steps.
   A blockquote becomes the tip. Optional front matter: needs (list), tip (string). #}

{% if crumbs %}{% include "partials/breadcrumbs.njk" %}{% endif %}

{% set overline = overline or "Practical" %}

<article class="tpl tpl--practical">
  {% include "partials/page-header.njk" %}

  {% if needs and needs.length %}
  <div class="content-column section-block needs">
    <h2 class="subhead">You'll need</h2>
    <ul class="needs__list">
      {% for item in needs %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {% if tip %}
  <div class="tip content-column">
    <p><strong>Tip —</strong> {{ tip }}</p>
  </div>
  {% endif %}
</article>
