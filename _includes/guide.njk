---
layout: base.njk
---

{% set crumbs = [
  {label: "Guides", url: "/guides/" },
  {label: title}
] %}
{% include "partials/breadcrumbs.njk" %}

<article>
  <header class="place-header">
    <div class="place-header__type">Guide · {{ duration }}</div>
    <h1 class="place-header__title">{{ title }}</h1>
    {% if description %}<p class="place-header__subtitle">{{ description }}</p>{% endif %}
  </header>

  <div class="prose content-column">
    {{ content | safe }}
  </div>

  {% if places and places.length %}
  <div style="margin-top:var(--space-7);max-width:var(--content-width)">
    <hr class="rule">
    <h3 style="font-family:var(--font-display);font-size:var(--text-h3);font-weight:600;margin-bottom:var(--space-3)">Places in this guide</h3>
    <div class="place-grid">
      {% for placeSlug in places %}
        {% set place = collections.places | findBySlug(placeSlug) %}
        {% if place %}
          {% include "partials/place-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>
