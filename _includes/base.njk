<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  {# Canonical URL #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Open Graph #}
  <meta property="og:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta property="og:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">{% endif %}

  {# Twitter Card #}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if seo and seo.title %}{{ seo.title }}{% elif title %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

  {# Analytics — uncomment one: #}
  {# Plausible (recommended, $9/mo, no cookie banner needed): #}
  {# <script defer data-domain="andean-road.com" src="https://plausible.io/js/script.js"></script> #}
  {# GA4 (free): #}
  {# <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script> #}
  {# <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-XXXXXXXXXX');</script> #}

  {# Fonts — Rethink Sans + Source Serif 4 #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

  {# Styles #}
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main-content" class="wrap">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script>
    const root = document.documentElement;
    function toggleTheme() {
      const isDark = root.dataset.theme === 'dark';
      root.dataset.theme = isDark ? '' : 'dark';
      localStorage.setItem('theme', isDark ? '' : 'dark');
    }
    const saved = localStorage.getItem('theme');
    if (saved) root.dataset.theme = saved;
  </script>
</body>
</html>
