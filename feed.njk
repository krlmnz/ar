---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{#- One feed across everything: on a site this size a new place is as much
    news as a new guide. Sorted by front-matter `updated` (every content file
    has one; `entry.date` is only the fallback), newest 30.

    Escaping: Nunjucks autoescape covers titles. Body text is trickier —
    templateContent already carries HTML entities, so after stripping tags we
    decode them (amp last, so &amp;lt; survives) and let autoescape re-encode
    once. Without the round-trip, "wine & cheese" would reach readers as
    "wine &amp; cheese". Dates get T00:00:00Z because Atom wants a full
    RFC 3339 instant and `updated` is only ever a day. -#}
{%- set entries = collections.guides.concat(collections.practical, collections.places) | sort(true, false, 'data.updated') %}
{%- set entries = entries.slice(0, 30) %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <id>{{ site.url }}/</id>
  <link href="{{ site.url }}/"/>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <updated>{{ (entries[0].data.updated or entries[0].date) | isoDate }}T00:00:00Z</updated>
  <author>
    <name>{{ site.author }}</name>
  </author>
  {%- for entry in entries %}
  <entry>
    <title>{{ entry.data.title }}</title>
    <id>{{ site.url }}{{ entry.url }}</id>
    <link href="{{ site.url }}{{ entry.url }}"/>
    <updated>{{ (entry.data.updated or entry.date) | isoDate }}T00:00:00Z</updated>
    {#- The heading-anchor permalink is an <a> whose text is "#" — stripHtml
        would leave that glyph stranded mid-sentence, so drop the whole link
        first. -#}
    <content type="text">{{ entry.templateContent | replace(r/<a\b[^>]*heading-anchor[^>]*>[\s\S]*?<\/a>/g, "") | stripHtml | replace("&lt;", "<") | replace("&gt;", ">") | replace("&quot;", '"') | replace("&#39;", "'") | replace("&amp;", "&") | truncate(500) }}</content>
  </entry>
  {%- endfor %}
</feed>
