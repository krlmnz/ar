  <!-- ── The three regimes ── -->
  <section class="tool-section" id="regimes">
    <div class="section-label">Section 01</div>
    <h2 class="section-title">The three regimes</h2>
    <div class="section-description">Every spatial dataset lives somewhere on a continuum from perfect clustering to perfect dispersion. These three snapshots mark the extremes and the null.</div>

    <div class="sa-regimes">
      <div>
